# Slim runtime for the UI: the official image is Ubuntu + full node + a 112 MB dist that we
# replace. Take the app, node_modules and the supervisor config into a slim node base and
# copy everything with --chown: a later `chown -R` would duplicate the whole tree in a layer.
FROM ghcr.io/datalens-tech/datalens-ui:0.3831.0 AS upstream

FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends nginx-light supervisor ca-certificates \
 && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/locale \
           /usr/lib/node_modules/npm /usr/local/lib/node_modules/npm \
 && rm -f /etc/nginx/sites-enabled/default \
 && useradd -m app

COPY --from=upstream --chown=app:app /opt/app/node_modules /opt/app/node_modules
COPY --from=upstream /etc/nginx/entrypoint.sh /etc/nginx/entrypoint.sh
COPY --from=upstream /etc/supervisor/supervisord.conf /etc/supervisor/supervisord.conf

COPY --chown=app:app dist /opt/app/dist
COPY --chown=app:app theme-data /opt/app/theme-data
COPY ui-nginx.conf /etc/nginx/nginx.conf

RUN find /opt/app/dist -name '._*' -delete && chmod +x /etc/nginx/entrypoint.sh

WORKDIR /opt/app
USER app
ENV NODE_ENV=production \
    APP_PORT=3030 \
    APP_INSTALLATION=opensource \
    THEMES_DATA_DIR=/opt/app/theme-data \
    THEMES_DATA_PATH=/opt/app/theme-data/themes.json
EXPOSE 8080
ENTRYPOINT ["/usr/bin/supervisord","-c","/etc/supervisor/supervisord.conf"]
