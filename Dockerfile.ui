# The official DataLens UI image with our built theme-fork dist and the routing that sends
# /api/run* to the Rust monolith.
FROM ghcr.io/datalens-tech/datalens-ui:0.3831.0
COPY dist/ /opt/app/dist/
# macOS tarballs carry AppleDouble `._*` siblings; node would require them and crash.
RUN find /opt/app/dist -name '._*' -delete
COPY ui-nginx.conf /etc/nginx/nginx.conf
